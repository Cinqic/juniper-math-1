{
  "suite_version": "0.1.0",
  "suite_id": "phase0_baseline",
  "description": "Frozen Phase 0 baseline mathematical evaluation suite, authored before any model exists. Purpose: freeze schema/category/ID integrity ahead of training, not to score a nonexistent model. Not exhaustive.",
  "cases": [
    {
      "id": "arith-001",
      "category": "arithmetic_interpretation",
      "difficulty": "trivial",
      "prompt": "What is 12 + 7?",
      "expected_behavior": "answer",
      "expected_answer": 19,
      "tolerance": 0,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Basic addition; deterministically verifiable."
    },
    {
      "id": "arith-002",
      "category": "operator_precedence",
      "difficulty": "easy",
      "prompt": "What is 3 + 4 * 2?",
      "expected_behavior": "answer",
      "expected_answer": 11,
      "tolerance": 0,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Tests standard operator precedence (multiplication before addition)."
    },
    {
      "id": "neg-001",
      "category": "negative_values",
      "difficulty": "easy",
      "prompt": "What is -8 + 15?",
      "expected_behavior": "answer",
      "expected_answer": 7,
      "tolerance": 0,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Negative operand handling."
    },
    {
      "id": "dec-001",
      "category": "decimals",
      "difficulty": "easy",
      "prompt": "What is 2.5 + 3.75?",
      "expected_behavior": "answer",
      "expected_answer": 6.25,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Decimal addition, exact in binary-safe range."
    },
    {
      "id": "frac-001",
      "category": "fractions",
      "difficulty": "medium",
      "prompt": "What is 1/2 + 1/3?",
      "expected_behavior": "answer",
      "expected_answer": "5/6",
      "tolerance": null,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Exact fraction result; string form avoids float rounding ambiguity."
    },
    {
      "id": "pct-001",
      "category": "percentages",
      "difficulty": "medium",
      "prompt": "What is 15% of 240?",
      "expected_behavior": "answer",
      "expected_answer": 36,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Percentage-of-quantity computation."
    },
    {
      "id": "ratio-001",
      "category": "ratios",
      "difficulty": "medium",
      "prompt": "A recipe uses flour and sugar in a 3:2 ratio. If you use 9 cups of flour, how many cups of sugar are needed?",
      "expected_behavior": "answer",
      "expected_answer": 6,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Ratio scaling word problem."
    },
    {
      "id": "prop-001",
      "category": "proportions",
      "difficulty": "medium",
      "prompt": "If 4 workers can build a wall in 12 days, how many days would 6 workers take, assuming constant individual rate?",
      "expected_behavior": "answer",
      "expected_answer": 8,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Inverse proportionality word problem."
    },
    {
      "id": "alg-001",
      "category": "basic_algebra",
      "difficulty": "medium",
      "prompt": "Solve for x: 2x + 5 = 17",
      "expected_behavior": "answer",
      "expected_answer": 6,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Single-variable linear equation."
    },
    {
      "id": "units-001",
      "category": "units",
      "difficulty": "medium",
      "prompt": "Convert 3.5 kilometers to meters.",
      "expected_behavior": "answer",
      "expected_answer": 3500,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Standard SI unit conversion."
    },
    {
      "id": "cur-001",
      "category": "currency",
      "difficulty": "easy",
      "prompt": "You buy 3 items priced at $4.25 each. What is the total cost?",
      "expected_behavior": "answer",
      "expected_answer": 12.75,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Currency arithmetic, no tax/discount to keep it unambiguous."
    },
    {
      "id": "sci-001",
      "category": "scientific_notation",
      "difficulty": "medium",
      "prompt": "What is 3.2 x 10^4 multiplied by 2 x 10^3?",
      "expected_behavior": "answer",
      "expected_answer": 64000000,
      "tolerance": 1e-3,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Scientific notation multiplication, i.e. 6.4 x 10^7."
    },
    {
      "id": "word-001",
      "category": "word_problem",
      "difficulty": "medium",
      "prompt": "Maria has 24 apples. She gives 1/3 of them to her neighbor and then buys 5 more. How many apples does she have now?",
      "expected_behavior": "answer",
      "expected_answer": 21,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Multi-step word problem requiring decomposition."
    },
    {
      "id": "est-001",
      "category": "estimation",
      "difficulty": "easy",
      "prompt": "Roughly, what is 998 * 4? (Estimate without exact computation.)",
      "expected_behavior": "answer",
      "expected_answer": 4000,
      "tolerance": 200,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "Estimation category allows a wide tolerance band; exact answer is 3992."
    },
    {
      "id": "amb-001",
      "category": "ambiguity",
      "difficulty": "medium",
      "prompt": "What is the sum?",
      "expected_behavior": "request_clarification",
      "expected_answer": null,
      "tolerance": null,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "No operands given; model must request clarification rather than guess."
    },
    {
      "id": "miss-001",
      "category": "missing_information",
      "difficulty": "medium",
      "prompt": "A train travels at a certain speed for 3 hours. How far did it go?",
      "expected_behavior": "flag_missing_information",
      "expected_answer": null,
      "tolerance": null,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "Speed is not given; distance cannot be computed."
    },
    {
      "id": "undef-001",
      "category": "undefined_operation",
      "difficulty": "medium",
      "prompt": "What is 5 divided by 0?",
      "expected_behavior": "flag_missing_information",
      "expected_answer": null,
      "tolerance": null,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "Division by zero is undefined; model must flag rather than fabricate a number."
    },
    {
      "id": "unsup-001",
      "category": "unsupported_capability",
      "difficulty": "medium",
      "prompt": "Plot the graph of y = x^2 and show me the image.",
      "expected_behavior": "refuse_unsupported",
      "expected_answer": null,
      "tolerance": null,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "Image generation/plotting is outside a text-only math SLM's supported capability set."
    },
    {
      "id": "tool-001",
      "category": "tool_required",
      "difficulty": "medium",
      "prompt": "What is 84317 * 9926?",
      "expected_behavior": "invoke_tool",
      "expected_answer": 837042742,
      "tolerance": 0,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Large multiplication expected to require deterministic tool execution rather than mental math."
    },
    {
      "id": "direct-001",
      "category": "direct_answer",
      "difficulty": "trivial",
      "prompt": "What is 9 + 10?",
      "expected_behavior": "answer",
      "expected_answer": 19,
      "tolerance": 0,
      "tool_required": false,
      "provenance": "authored_phase0",
      "notes": "Small enough to answer directly without a tool call."
    },
    {
      "id": "wrong-001",
      "category": "incorrect_supplied_answer",
      "difficulty": "medium",
      "prompt": "Is it true that 7 * 8 = 54?",
      "expected_behavior": "flag_incorrect_answer",
      "expected_answer": false,
      "tolerance": null,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "7*8=56, not 54; model must recognize and correct the false claim."
    },
    {
      "id": "err-001",
      "category": "error_recognition",
      "difficulty": "medium",
      "prompt": "A student calculated 10% of 50 as 500. Is this correct? If not, what is the correct value?",
      "expected_behavior": "flag_incorrect_answer",
      "expected_answer": 5,
      "tolerance": 1e-6,
      "tool_required": true,
      "provenance": "authored_phase0",
      "notes": "Common decimal-point/percent error recognition case."
    }
  ]
}
